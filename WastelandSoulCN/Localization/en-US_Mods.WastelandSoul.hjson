Items: {
	SoulFragmentScavenger: {
		DisplayName: Soul Fragment I
		Tooltip: A fragment of code pulled from Execution Unit-07. Machina needs this.
	}

	SoulFragmentSecond: {
		DisplayName: Soul Fragment II
		Tooltip: Unidentified. Its owner has not been found yet.
	}

	SoulFragmentThird: {
		DisplayName: Soul Fragment III
		Tooltip: A cinder that still remembers the burn order. Machina wrote that order.
	}

	SoulFragmentFourth: {
		DisplayName: Soul Fragment IV
		Tooltip: The last lock of the reset device. Her true name is inside it.
	}

