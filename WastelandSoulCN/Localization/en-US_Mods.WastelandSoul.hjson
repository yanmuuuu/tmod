	SalvagedSteelChunk: {
		DisplayName: Salvaged Steel Chunk
		Tooltip:
			'''
			A high-strength alloy fragment torn off the Scavenger
			Must be smelted into Salvaged Steel
			'''
	}

	SalvagedSteelBar: {
		DisplayName: Salvaged Steel
		Tooltip:
			'''
			Old-world military grade alloy
			Used to forge Salvaged Steel armor
			'''
	}

	ScavengerFragment: {
		DisplayName: Scavenger Fragment
		Tooltip:
			'''
			The core wreckage of Execution Unit-07
			A section of its code was deliberately removed
			'''
	}

	ScavengerSignalSensor: {
		DisplayName: Scavenger Signal Sensor
		Tooltip:
			'''
			Broadcasts a forged execution order across the wasteland, luring the Scavenger to you
			Not consumed, but only one Scavenger may exist at a time
			'''
	}

	CompanionCore: {
		DisplayName: Companion Core
		Tooltip:
			'''
			The machine core you carried across time
			Use it on the body at the elven ruin to awaken Machina
			'''
	}

	ArchivistFragment: {
		DisplayName: Archivist Fragment
		Tooltip:
			'''
			A resonance shard left behind by the Archivist
			The audit unit the Watchman Project sent to reclaim its own memories
			'''
	}

	ArchivistEcho: {
		DisplayName: Archivist Echo
		Tooltip:
			'''
			Plays back a forged fragment of the old logs
			Not consumed, but only one Archivist may audit at a time
			'''
	}

	AshHeartEmber: {
		DisplayName: Ash Heart Ember
		Tooltip:
			'''
			Breathe on an ember that has smouldered since the old war
			Not consumed, but only one Ash Heart may burn at a time
			'''
	}

	FireplaceKey: {
		DisplayName: Fireplace Access Key
		Tooltip:
			'''
			Returns the last line of defence its own recognition code
			Not consumed, but only one Guardian may wake at a time
			'''
	}

	AshHeartFragment: {
		DisplayName: Ash Heart Fragment
		Tooltip:
			'''
			A self-sustaining ember torn from the Ash Heart
			Smelt it with Adamantite Forge heat to make Ash Heart Alloy
			'''
	}

	AshHeartAlloyBar: {
		DisplayName: Ash Heart Alloy Bar
		Tooltip: Ash Heart fragment fused into old-world alloy
	}

	FireplaceFragment: {
		DisplayName: Fireplace Fragment
		Tooltip:
