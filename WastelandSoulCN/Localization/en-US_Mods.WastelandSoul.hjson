	Chip: {
		DisplayName: Chip
		Tooltip: A stamped wafer pulled out of wasteland machines. Machina will trade for these.
	}

	DawnSeal: {
		DisplayName: Dawn Seal
		Tooltip: She agreed to carry the reset. This world still ends. The next one will remember her.
	}

	UnburnedName: {
		DisplayName: Unburned Name
		Tooltip: She refused to be the weapon again. The body keeps the name it was given.
	}

	ScavengerWarriorCharm: {
		DisplayName: Scavenger Warrior Charm
		Tooltip: Melee damage and swing speed, salvaged from a purge unit.
	}

	ScavengerMageCharm: {
		DisplayName: Scavenger Mage Charm
		Tooltip: A little more mana, and spells cost less to cast.
	}

	ScavengerRangerCharm: {
		DisplayName: Scavenger Ranger Charm
		Tooltip: Ranged damage, and a chance to keep the round.
	}

	ScavengerSummonerCharm: {
		DisplayName: Scavenger Summoner Charm
		Tooltip: One extra minion slot, bolted on.
	}

	ScavengerRogueCharm: {
		DisplayName: Scavenger Rogue Charm
		Tooltip: Thrown damage and lighter steps.
	}

	ArchivistWarriorCharm: {
		DisplayName: Archivist Warrior Charm
		Tooltip: Melee damage and critical chance, indexed.
	}

	ArchivistMageCharm: {
		DisplayName: Archivist Mage Charm
		Tooltip: Magic damage, and spells burn less mana.
	}

	ArchivistRangerCharm: {
		DisplayName: Archivist Ranger Charm
		Tooltip: Ranged damage and a sharper eye.
	}

	ArchivistSummonerCharm: {
		DisplayName: Archivist Summoner Charm
		Tooltip: Summon damage, filed and returned.
	}

	ArchivistRogueCharm: {
		DisplayName: Archivist Rogue Charm
		Tooltip: Thrown damage and critical chance.
	}

	AshHeartWarriorCharm: {
		DisplayName: Ash Heart Warrior Charm
		Tooltip: Melee damage, and the body knits a little while it burns.
	}

	AshHeartMageCharm: {
		DisplayName: Ash Heart Mage Charm
		Tooltip: Magic damage and faster mana recovery.
	}

	AshHeartRangerCharm: {
		DisplayName: Ash Heart Ranger Charm
		Tooltip: Ranged damage, and rounds that sometimes stay in the gun.
	}

	AshHeartSummonerCharm: {
		DisplayName: Ash Heart Summoner Charm
		Tooltip: Summon damage and one more minion.
	}

	AshHeartRogueCharm: {
		DisplayName: Ash Heart Rogue Charm
		Tooltip: Thrown damage. Hits sometimes set the target alight.
	}

	FireplaceWarriorCharm: {
		DisplayName: Fireplace Warrior Charm
		Tooltip: Melee damage and swing speed from the last lock.
	}

	FireplaceMageCharm: {
		DisplayName: Fireplace Mage Charm
		Tooltip: Magic damage, and spells cost noticeably less.
	}

	FireplaceRangerCharm: {
		DisplayName: Fireplace Ranger Charm
		Tooltip: Ranged damage and critical chance.
	}

	FireplaceSummonerCharm: {
		DisplayName: Fireplace Summoner Charm
		Tooltip: Summon damage and one more minion.
	}

	FireplaceRogueCharm: {
		DisplayName: Fireplace Rogue Charm
		Tooltip: Thrown damage and a quicker stride.
	}

	ScavengerCWarrior: {
		DisplayName: Scrap Cleaver
		Tooltip: A crawler was still holding this. It throws a shard of scrap.
	}

	ScavengerCMage: {
		DisplayName: Scrap Spark
		Tooltip: A cracked coil that still throws charged scrap.
	}

	ScavengerCRanger: {
		DisplayName: Scrap Pistol
		Tooltip: Ugly, loud, and surprisingly straight.
	}

	ScavengerCSummoner: {
		DisplayName: Scrap Drone Staff
		Tooltip: Calls a small salvage drone. It is not the repair kind.
	}

	ScavengerCRogue: {
		DisplayName: Scrap Caltrop
		Tooltip: A spinning scrap of metal that does not ask to be picked back up.
	}

	ArchivistCWarrior: {
		DisplayName: Index Blade
		Tooltip: A short bone-white arc, torn out of a moth's wings.
	}

	ArchivistCMage: {
		DisplayName: Loose Index
		Tooltip: Pages that bounce and confuse whatever they hit.
	}

	ArchivistCRanger: {
		DisplayName: Bone Sliver Gun
		Tooltip: Fires thin archive slivers.
	}

	ArchivistCSummoner: {
		DisplayName: Familiar Splinter
		Tooltip: A cracked staff that still remembers one familiar.
	}

	ArchivistCRogue: {
		DisplayName: Returning Bone
		Tooltip: It goes out, then it comes back.
	}

	AshHeartCWarrior: {
		DisplayName: Cinder Edge
		Tooltip: A stalker's rib, still hot, swung as a sword.
	}

	AshHeartCMage: {
		DisplayName: Heart Coal
		Tooltip: Throws a falling coal that burns on impact.
	}

	AshHeartCRanger: {
		DisplayName: Ash Shot
		Tooltip: Fast cinders instead of bullets' manners.
	}

	AshHeartCSummoner: {
		DisplayName: Ember Husk Staff
		Tooltip: Calls a cinder that used to be part of the Heart.
	}

	AshHeartCRogue: {
		DisplayName: Ash Splinter
		Tooltip: A thrown splinter that keeps burning after it leaves the hand.
	}

	FireplaceCWarrior: {
		DisplayName: Hearth Blade
		Tooltip: Cold metal with a furnace edge. A warden dropped it.
	}

	FireplaceCMage: {
		DisplayName: Cold Lamp
		Tooltip: A slow, bright bolt from the Fireplace's spare parts.
	}

	FireplaceCRanger: {
		DisplayName: Nail Thrower
		Tooltip: Fires the nails the Guardian used to hold the reset shut.
	}

	FireplaceCSummoner: {
		DisplayName: Sentry Wick
		Tooltip: Calls a floating sentry that still knows the hearth.
	}

	FireplaceCRogue: {
		DisplayName: Returning Razor
		Tooltip: A cold razor that flies out and comes home.
	}
}

