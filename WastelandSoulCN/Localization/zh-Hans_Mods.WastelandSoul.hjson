	ScavengerSignalSensor: {
		DisplayName: 清道夫信号传感器
		Tooltip:
			'''
			向废土广播一段伪造的执行指令，把清道夫引到你身边
			使用后不消耗，但同一时间只允许存在一只清道夫
			'''
	}
	CompanionCore: {
		DisplayName: 智械核心
		Tooltip:
			'''
			你穿越时间带来的机械核心
			在精灵族遗迹的躯体上使用，唤醒智械人
			'''
	}
	ArchivistFragment: {
		DisplayName: 归档者残响碎片
		Tooltip:
			'''
			归档者留下的共振碎片
			「守望者计划」派来回收自身记忆的审计单元
			'''
	}
	ArchivistEcho: {
		DisplayName: 归档者残响
		Tooltip:
