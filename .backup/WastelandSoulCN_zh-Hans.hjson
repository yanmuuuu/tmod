Configs: {
	WastelandConfig: {
		DisplayName: 废土魂穿 - 设置
		ScavengerInvasionEnabled.Label: 清道夫定期来袭
		InvasionCycleDays.Label: 来袭周期（天）
		InvasionWarning.Label: 显示来袭预警
		NoLootOnSelfDestruct: {
			Label: 过载自毁后不给掉落
			Tooltip: 清道夫进入过载冲锋并自行解体时，不掉落任何战利品，也不推进剧情
		}
	}
	WastelandVisualConfig: {
		DisplayName: 废土魂穿 - 视觉
		Enable3DArmorVisuals: {
			Label: 3D 精钢护甲
			Tooltip: 把精钢头盔、胸甲与护腿画成 3D 模型贴在玩家身上。默认关闭——护甲的穿身贴图本来就是全透明的，关掉时就是看不见护甲
		}
	}
}
BossChecklist: {
	Scavenger.SpawnInfo: 每 5 天一次（19:30 预警、20:30 抵达），或用「清道夫信号传感器」把它引过来
	Archivist.SpawnInfo: 在恶魔/猩红祭坛合成「归档者残响」（归档者残响碎片 ×8 + 骨头 ×5 + 陨石锭 ×3）并使用，把那台审计单元叫下来
	AshHeart.SpawnInfo: 在恶魔/猩红祭坛合成「灰烬之心余烬」（灰烬之心碎片 ×10 + 灵液 ×2 + 狱石锭 ×5），击败世纪之花后使用
	FireplaceGuardian.SpawnInfo: 在恶魔/猩红祭坛合成「壁炉通行密钥」（壁炉残骸 ×12 + 壁炉合金锭 ×4 + 日耀碎片 ×6）。它守在壁炉深处
}
NPCs: {
	MechanicalCompanion: {
		DisplayName: 智械人
		TownNPCMood: {
			Content: 我的数据流很稳定。
			NoHome: 我还没有地方安放这具身体。
			FarFromHome: 我们离壁炉太远了。
			LoveSpace: 我喜欢这份空旷——没有什么会被误判成污染。
			DislikeCrowded: 有点挤。我的传感器被压住了。
			HateCrowded: 太吵了。我的程序快要报错了。
			LikeBiome: 这里的参数还算合意——{BiomeName}。
			DislikeBiome: "{BiomeName}让我想起被污染的地面。"
			HateBiome: 我讨厌{BiomeName}。我的数据在这里会腐坏。
			LoveNPC: 在{NPCName}身边，我的核心频率会稳定下来。
			LikeNPC: "{NPCName}还可以接受。"
			DislikeNPC: "{NPCName}产生的噪音太多了。"
			HateNPC: 我讨厌{NPCName}。他们的存在让我的传感器过载。
			LikeNPC_Princess: "{NPCName}很可爱。"
			Princess_LovesNPC: "{NPCName}很可爱。"
		}
		Census.SpawnCondition: 出现条件未知
	}
