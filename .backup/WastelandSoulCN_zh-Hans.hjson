	SalvagedSteelChunk: {
		DisplayName: 精钢碎块
		Tooltip:
			'''
			从清道夫身上撕下来的高强度合金碎片
			需要熔炼成精钢
			'''
	}
	SalvagedSteelBar: {
		DisplayName: 精钢
		Tooltip:
			'''
			旧时代军用级合金
			用来锻造精钢套装
			'''
	}
	ScavengerFragment: {
		DisplayName: 清道夫残片
		Tooltip:
			'''
			执行单元-07 的核心残骸
			它的一段代码被刻意抹掉了
			'''
	}
	ScavengerSignalSensor: {
		DisplayName: 清道夫信号传感器
		Tooltip:
			'''
			向废土广播一段伪造的执行指令，把清道夫引到你身边
			使用后不消耗，但同一时间只允许存在一只清道夫
			'''
	}
	CompanionCore: {
		DisplayName: 智械核心
		Tooltip:
			'''
			你穿越时间带来的机械核心
			在精灵族遗迹的躯体上使用，唤醒智械人
			'''
	}
	ArchivistFragment: {
		DisplayName: 归档者残响碎片
		Tooltip:
			'''
			归档者留下的共振碎片
			「守望者计划」派来回收自身记忆的审计单元
			'''
	}
	ArchivistEcho: {
		DisplayName: 归档者残响
		Tooltip:
			'''
			播放一段伪造的旧日志残片
			使用后不消耗，但同一时间只允许存在一只归档者
			'''
	}
	AshHeartEmber: {
		DisplayName: 灰烬之心余烬
		Tooltip:
			'''
			往一簇自旧时代战争起就在阴燃的余烬上吹一口气
			使用后不消耗，但同一时间只允许存在一颗灰烬之心
			'''
	}
	FireplaceKey: {
		DisplayName: 壁炉通行密钥
		Tooltip:
			'''
			把最后一道防线自己的识别码还给它
			使用后不消耗，但同一时间只允许存在一名壁炉守卫
			'''
	}
	AshHeartFragment: {
		DisplayName: 灰烬之心碎片
		Tooltip:
